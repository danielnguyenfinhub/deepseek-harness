{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "DSH_CLIENT_COMMIT_HASH=$RAILWAY_GIT_COMMIT_SHA pnpm run build"
  },
  "deploy": {
    "startCommand": "node scripts/railway-serve.mjs",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
